/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config for running on a single machine (Apple M5 Pro, 18 CPUs, 24 GB)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use as follows:
        nextflow run nf-core/evefinder -profile local,<docker/singularity/apptainer> ...

    With Docker the tasks run inside a VM (Colima here: 16 CPUs, ~19.5 GB usable),
    so the limits follow the VM, not the Mac. Raise them with
    `colima stop && colima start --memory <GB>` (or Docker Desktop's Settings >
    Resources), then edit the values below to match.
----------------------------------------------------------------------------------------
*/

// What all tasks running at once may use
executor {
    cpus   = 16
    memory = 18.GB
}

// What a single task may request (caps the process_* labels in base.config)
process {
    resourceLimits = [
        cpus  : 16,
        memory: 18.GB,
        time  : 48.h
    ]

    withName: 'EEFINDER_ALIGN' {
        cpus     = 8
        memory   = 12.GB
        maxForks = 1
    }
}
