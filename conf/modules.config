/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'EEFINDER_.*' {
        // the image's ENTRYPOINT is `eefinder`, which would swallow Nextflow's `bash .command.run`
        containerOptions = { workflow.containerEngine in ['docker', 'podman'] ? '--entrypoint ""' : '' }
        // intermediates; the final outputs are set below
        publishDir = [
            path: { "${params.outdir}/screening/${meta.id}/tmp_files" },
            mode: params.publish_dir_mode,
            enabled: !params.removetmp,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //
    // prepare_inputs
    //
    withName: 'WGET_.*' {
        publishDir = [ enabled: false ]
    }

    withName: 'RESOLVE_HOST_TAXON' {
        containerOptions = { workflow.containerEngine in ['docker', 'podman'] ? '--entrypoint ""' : '' }
        publishDir       = [ enabled: false ]
    }

    withName: 'UNZIP' {
        publishDir = [
            path: { "${params.outdir}/prepare_inputs/genomes" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'SEQKIT_REPLACE' {
        // ENA headers: `ENA|<acc>|<acc.version> desc` -> `<acc.version> desc`
        ext.args   = "-p '^ENA\\|[^|]+\\|' -r ''"
        publishDir = [
            path: { "${params.outdir}/prepare_inputs/genomes" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EEFINDER_GETDATABASES_HOST' {
        ext.args   = { [
            "-md ${params.search_mode}",
            "--attempts ${params.getdb_attempts}",
            "--stall-timeout ${params.getdb_stall_timeout}",
            params.getdb_keep_download        ? '--keep-download'         : '--remove-download',
            params.host_refseq                ? '--refseq'                : '--all-sequences',
            params.host_cluster               ? '--cluster'               : '--no-cluster',
            params.host_exclude_uninformative ? '--exclude-uninformative' : '--keep-uninformative',
            params.host_exclude_taxon         ? params.host_exclude_taxon.toString().tokenize(',').collect { t -> "--exclude-taxon '${t.trim()}'" }.join(' ') : '',
            params.eefinder_debug             ? '--debug'                 : '',
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/prepare_inputs/host_baits" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EEFINDER_GETDATABASES_VIRUS' {
        ext.args   = { [
            "-md ${params.search_mode}",
            "--attempts ${params.getdb_attempts}",
            "--stall-timeout ${params.getdb_stall_timeout}",
            "--split-level ${params.virus_db_split_level}",
            meta.released_before                  ? "--released-before ${meta.released_before}" : '',
            params.getdb_keep_download            ? '--keep-download'         : '--remove-download',
            params.virus_db_refseq                ? '--refseq'                : '--all-sequences',
            params.virus_db_cluster               ? '--cluster'               : '--no-cluster',
            params.virus_db_exclude_uninformative ? '--exclude-uninformative' : '--keep-uninformative',
            params.virus_db_standardize_proteins  ? '--standardize-proteins'  : '--raw-proteins',
            params.virus_db_include_unranked      ? '--include-unranked'      : '--skip-unranked',
            params.virus_db_exclude_taxon         ? params.virus_db_exclude_taxon.toString().tokenize(',').collect { t -> "--exclude-taxon '${t.trim()}'" }.join(' ') : '',
            params.eefinder_debug                 ? '--debug'                 : '',
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/prepare_inputs/virus_db" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //
    // screening: final outputs as `PREFIX.EEs.*`, as `eefinder screening all` names them
    //
    withName: 'EEFINDER_PREPARE' {
        ext.args   = { "-md ${params.search_mode} ${params.eefinder_debug ? '--debug' : ''}" }
        publishDir = [ enabled: false ]
    }

    withName: 'EEFINDER_CLEAN' {
        ext.args = { "-ln ${params.min_length} ${params.eefinder_debug ? '--debug' : ''}" }
    }

    withName: 'EEFINDER_ALIGN|EEFINDER_FILTER' {
        ext.args = { "-md ${params.search_mode} -tm ${params.translation_method} -rj ${params.range_junction} ${params.eefinder_debug ? '--debug' : ''}" }
    }

    withName: 'EEFINDER_TAXONOMY' {
        ext.args = { params.eefinder_debug ? '--debug' : '' }
    }

    withName: 'EEFINDER_MERGE' {
        ext.args = { "-lm ${params.merge_limit} -ml ${params.merge_level} ${params.eefinder_debug ? '--debug' : ''}" }
    }

    withName: 'EEFINDER_POSTPROCESS' {
        ext.args   = { [
            "-mp ${params.mask_per}",
            "-ov ${params.overlap}",
            "-an virus",
            params.clean_masked        ? '-cm' : '',
            params.target_families     ? params.target_families.toString().tokenize(',').collect { f -> "-tf '${f.trim()}'" }.join(' ') : '',
            params.non_target_families ? params.non_target_families.toString().tokenize(',').collect { f -> "-ntf '${f.trim()}'" }.join(' ') : '',
            params.eefinder_debug      ? '--debug' : '',
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/screening/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                filename.equals('versions.yml') ? null : filename
                    .replace('.elements.resolved.', '.EEs.')
                    .replace('.elements.cleaned.', '.EEs.cleaned.')
                    .replace('.elements.gff3', '.EEs.gff3')
                    .replace('.elements.faa', '.EEs.faa')
            }
        ]
    }

    withName: 'EEFINDER_FLANKS' {
        ext.args   = { "-fl ${params.flank} ${params.eefinder_debug ? '--debug' : ''}" }
        publishDir = [
            [
                path: { "${params.outdir}/screening/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: '*.flanks.fa',
                saveAs: { filename -> filename.replace('.flanks.fa', '.EEs.flanks.fa') }
            ],
            [
                path: { "${params.outdir}/screening/${meta.id}/tmp_files" },
                mode: params.publish_dir_mode,
                enabled: !params.removetmp,
                pattern: '*.{cleaned_genome.lengths.tsv,flanks.bed,flanks.slop.bed}'
            ]
        ]
    }

    //
    // screening: clustering, the tools' own outputs in tmp_files/
    //
    withName: 'CDHIT_CDHITEST' {
        // -n 5: word size allowed down to 80% identity; -p 1: alignment coordinates for the coverages
        ext.args   = { "-c ${params.cluster_identity} -n 5 -aS ${params.cluster_coverage} -aL ${params.cluster_coverage} -d 0 -p 1 -g 1" }
        ext.prefix = { "${meta.id}.EEs.cdhit" }
        publishDir = [
            path: { "${params.outdir}/screening/${meta.id}/tmp_files" },
            mode: params.publish_dir_mode,
            enabled: !params.removetmp,
            pattern: '*.clstr',
        ]
    }

    withName: 'VCLUST_PREFILTER|VCLUST_ALIGN|VCLUST_CLUSTER' {
        ext.prefix = { "${meta.id}.EEs.vclust" }
        publishDir = [
            path: { "${params.outdir}/screening/${meta.id}/tmp_files" },
            mode: params.publish_dir_mode,
            enabled: !params.removetmp,
            pattern: '*.tsv',
        ]
    }

    withName: 'VCLUST_CLUSTER' {
        // --algorithm cd-hit: greedy from the longest sequence, as cd-hit-est
        ext.args = { "--algorithm cd-hit --qcov ${params.cluster_coverage} --rcov ${params.cluster_coverage} --out-repr" }
    }

    withName: 'EE_CLUSTER_TABLE' {
        publishDir = [
            path: { "${params.outdir}/screening/${meta.id}" },
            mode: params.publish_dir_mode,
        ]
    }

    //
    // analysis: phylogeny, the tree as phylogeny/genomes.nwk
    //
    withName: 'RENAME_GENOME' {
        publishDir = [ enabled: false ]
    }

    withName: 'MASHTREE' {
        publishDir = [
            path: { "${params.outdir}/phylogeny" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.dnd') ? 'genomes.nwk' : filename },
        ]
    }

    //
    // analysis: plots
    //
    withName: 'EE_PLOT_DATA|EE_PHYLO_HEATMAP' {
        publishDir = [
            path: { "${params.outdir}/plots" },
            mode: params.publish_dir_mode,
            pattern: '*.{tsv,html}',
        ]
    }

    withName: 'EE_SWARMPLOT' {
        ext.args   = { "--top ${params.swarm_top_proteins}" }
        publishDir = [
            path: { "${params.outdir}/plots/${meta.id}" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'KRONA_KTIMPORTTEXT' {
        ext.prefix = { "${meta.id}.krona" }
        publishDir = [
            path: { "${params.outdir}/plots/${meta.id}" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
