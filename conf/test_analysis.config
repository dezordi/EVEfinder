/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for testing --step analysis
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Analyses the results of the `test` profile, read from the same --outdir:

        nextflow run nf-core/evefinder -profile test,<docker/singularity> --outdir <OUTDIR>
        nextflow run nf-core/evefinder -profile test_analysis,<docker/singularity> --outdir <OUTDIR>

    Three genomes, two of them without elements: a mashtree tree, and plots.
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test analysis profile'
    config_profile_description = 'Analysis of the test profile results'

    step             = 'analysis'
    input            = "${projectDir}/assets/samplesheet_screening.csv"
    screening_outdir = params.outdir
}
